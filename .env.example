# URL publique du site (sitemap, robots, balises Open Graph). Définie au moment du build.
SITE_URL=https://example.com

# URL de l'API du backend qui reçoit la liste d'attente (POST JSON).
# Si elle est absente, /api/waitlist répond « indisponible ». Aucun secret ici : la définir
# dans l'hébergeur, jamais dans le dépôt.
WAITLIST_API_URL=
