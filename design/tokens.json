{
  "$description": "Joga design tokens v0.1 (source unique pour mobile, admin-panel et site). Contrastes WCAG calculés sur ces paires.",
  "color": {
    "bg":            { "light": "#FFFFFF", "dark": "#0A0A0A", "role": "Fond d'écran" },
    "surface":       { "light": "#F4F4F4", "dark": "#171717", "role": "Cartes, champs, zones de réponse" },
    "surface-2":     { "light": "#EAEAEA", "dark": "#262626", "role": "Boutons secondaires, bulles reçues, état désactivé" },
    "border":        { "light": "#E0E0E0", "dark": "#262626", "role": "Séparateurs décoratifs" },
    "border-strong": { "light": "#8F8F8F", "dark": "#737373", "role": "Contour des champs et boutons secondaires (3,2:1 / 4,2:1)" },
    "text":          { "light": "#0A0A0A", "dark": "#FAFAFA", "role": "Texte principal (19,8:1 / 19,0:1)" },
    "text-2":        { "light": "#595959", "dark": "#A3A3A3", "role": "Texte secondaire (7,0:1 / 7,9:1)" },
    "primary":       { "light": "#0A0A0A", "dark": "#FAFAFA", "role": "Bouton principal, onglet actif" },
    "on-primary":    { "light": "#FFFFFF", "dark": "#0A0A0A", "role": "Texte sur primary" },
    "danger":        { "light": "#C62828", "dark": "#FF6B6B", "role": "Erreurs, signaler, supprimer (5,6:1 / 7,1:1)" },
    "success":       { "light": "#1B7F3B", "dark": "#4CD27A", "role": "Confirmations (5,1:1 / 10,2:1)" },
    "disabled-text": { "light": "#8F8F8F", "dark": "#8F8F8F", "role": "Texte désactivé sur surface-2 (exempté de contraste)" }
  },
  "scrim": {
    "photo": { "from": "rgba(0,0,0,0.78)", "to": "rgba(0,0,0,0)", "height": 130, "role": "Dégradé bas des photos pour le texte blanc" }
  },
  "font": {
    "serif": { "family": "Instrument Serif", "weights": [400], "styles": ["normal", "italic"] },
    "sans":  { "family": "Inter", "weights": [400, 500, 600] }
  },
  "type": {
    "display":  { "font": "serif", "size": 96, "lineHeight": 88, "letterSpacing": -0.03, "weight": 400 },
    "title-1":  { "font": "serif", "size": 40, "lineHeight": 44, "letterSpacing": -0.02, "weight": 400 },
    "title-2":  { "font": "serif", "size": 30, "lineHeight": 34, "letterSpacing": -0.02, "weight": 400 },
    "prompt":   { "font": "serif", "size": 25, "lineHeight": 30, "letterSpacing": 0, "weight": 400 },
    "headline": { "font": "sans",  "size": 20, "lineHeight": 26, "letterSpacing": 0, "weight": 600 },
    "body-l":   { "font": "sans",  "size": 17, "lineHeight": 26, "letterSpacing": 0, "weight": 400 },
    "body":     { "font": "sans",  "size": 15, "lineHeight": 22, "letterSpacing": 0, "weight": 400 },
    "label":    { "font": "sans",  "size": 16, "lineHeight": 20, "letterSpacing": 0, "weight": 600 },
    "caption":  { "font": "sans",  "size": 13, "lineHeight": 18, "letterSpacing": 0, "weight": 400 },
    "overline": { "font": "sans",  "size": 11, "lineHeight": 14, "letterSpacing": 0.14, "weight": 600, "uppercase": true }
  },
  "maxFontSizeMultiplier": 1.3,
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },
  "layout": { "screenMargin": 16, "cardPadding": 20, "blockGap": 12, "minTouchTarget": 44, "controlHeight": 56 },
  "radius": { "sm": 12, "md": 16, "lg": 24, "pill": 999 },
  "elevation": {
    "floating": { "light": "0 2px 10px rgba(0,0,0,0.12)", "dark": "none" }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "like": 240 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "likeScale": 1.25,
    "reduceMotion": "fondu seulement, sans mouvement"
  },
  "icon": { "grid": 24, "stroke": 1.6, "cap": "round", "join": "round", "activeStyle": "filled" },
  "photo": { "ratio": "4:5", "maxWidth": 1080, "maxHeight": 1350, "format": "webp", "quality": 80, "placeholder": "blurhash", "min": 3, "max": 6 }
}
